{
  "version": "0.0.1",
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "bash ./scripts/run.sh",
    "daemon": "bash ./scripts/daemon.sh",
    "stop": "bash ./scripts/stop.sh",
    "restart": "bash ./scripts/restart.sh",
    "status": "bash ./scripts/status.sh",
    "logs": "tail -f logs/main.log logs/telnet.log",
    "update": "deno run -A jsr:@ursamu/ursamu/cli update",
    "server": "deno run -A --watch --unstable-detect-cjs --unstable-kv --unstable-net ./src/main.ts",
    "telnet": "deno run -A --unstable-detect-cjs --unstable-kv --unstable-net ./src/telnet.ts",
    "test": "deno test --allow-all --unstable-kv --no-check",
    "showcase": "deno run -A ./src/cli/showcase.ts"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "ursamu": "../ursamu/packages/mush/mod.ts",
    "ursamu/": "../ursamu/packages/mush/",
    "@ursamu/mush": "../ursamu/packages/mush/mod.ts",
    "@ursamu/core": "../ursamu/packages/core/mod.ts",
    "@ursamu/ursamu": "../ursamu/packages/mush/mod.ts",
    "@ursamu/ursamu/app": "../ursamu/packages/mush/src/app.ts",
    "@ursamu/ursamu/channels": "../ursamu/packages/channels/src/channel-events.ts",
    "@ursamu/ursamu/jobs": "../ursamu/packages/jobs/mod.ts",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/fmt": "jsr:@std/fmt@^0.224.0",
    "@std/fmt/": "jsr:@std/fmt@^0.224.0/",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/semver": "jsr:@std/semver@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd",
    "@std/testing/mock": "jsr:@std/testing@^1.0.17/mock",
    "@ursamu/mushcode": "jsr:@ursamu/mushcode@^0.7.0",
    "@ursamu/mushcode/eval": "jsr:@ursamu/mushcode@^0.7.0/eval",
    "@ursamu/mushcode/parse": "jsr:@ursamu/mushcode@^0.7.0/parse",
    "@ursamu/parser": "npm:@ursamu/parser@1.2.4",
    "@digibear/tags": "npm:@digibear/tags@1.0.0",
    "bcrypt": "npm:bcryptjs@2.4.3",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "dotenv": "jsr:@std/dotenv@^0.224.0",
    "dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "dotenv/load": "jsr:@std/dotenv@^0.224.0/load",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@std/dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "lodash": "npm:lodash@^4.18.1",
    "quickjs-emscripten": "npm:quickjs-emscripten@0.29.0",
    "zod": "npm:zod@3.23.8",
    "@electric-sql/pglite": "npm:@electric-sql/pglite@^0.5.2",
    "@nicia-ai/typegraph": "npm:@nicia-ai/typegraph@^0.31.0",
    "@nicia-ai/typegraph/postgres/pglite": "npm:@nicia-ai/typegraph@^0.31.0/postgres/pglite",
    "@ursamu/builder": "../ursamu/packages/builder/mod.ts",
    "@ursamu/channels": "../ursamu/packages/channels/mod.ts",
    "@ursamu/help": "../ursamu/packages/help/mod.ts",
    "@ursamu/help-plugin": "../ursamu/packages/help/mod.ts",
    "@ursamu/bbs": "../ursamu/packages/bbs/mod.ts",
    "@ursamu/mail": "../ursamu/packages/mail/mod.ts",
    "@ursamu/mail-plugin": "../ursamu/packages/mail/mod.ts",
    "@ursamu/wiki": "../ursamu/packages/wiki/mod.ts",
    "@ursamu/jobs": "../ursamu/packages/jobs/mod.ts",
    "@ursamu/jobs-plugin": "../ursamu/packages/jobs/mod.ts",
    "@ursamu/combat": "../ursamu/packages/combat/mod.ts",
    "@ursamu/cofd": "../ursamu/packages/cofd/index.ts",
    "@ursamu/cofd-plugin": "../ursamu/packages/cofd/index.ts",
    "@ursamu/lang": "../ursamu/packages/lang/index.ts",
    "@ursamu/lang-plugin": "../ursamu/packages/lang/index.ts"
  }
}
