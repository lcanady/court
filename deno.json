{
  "name": "court",
  "version": "0.0.1",
  "nodeModulesDir": "auto",
  "tasks": {
    "start": "bash ./scripts/run.sh",
    "daemon": "bash ./scripts/daemon.sh",
    "stop": "bash ./scripts/stop.sh",
    "restart": "bash ./scripts/restart.sh",
    "status": "bash ./scripts/status.sh",
    "logs": "tail -f logs/main.log logs/telnet.log",
    "update": "deno run -A jsr:@ursamu/ursamu/cli update",
    "server": "deno run -A --watch --unstable-detect-cjs --unstable-kv --unstable-net ./src/main.ts",
    "telnet": "deno run -A --unstable-detect-cjs --unstable-kv --unstable-net ./src/telnet.ts",
    "test": "deno test --allow-all --unstable-kv --no-check"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "ursamu": "jsr:@ursamu/ursamu@^2.3.4",
    "ursamu/": "jsr:@ursamu/ursamu/",
    "@ursamu/mush": "jsr:@ursamu/mush",
    "@ursamu/core": "jsr:@ursamu/core",
    "@ursamu/ursamu": "jsr:@ursamu/ursamu@^2.3.4",
    "@ursamu/ursamu/app": "jsr:@ursamu/mush/app",
    "@ursamu/ursamu/channels": "jsr:@ursamu/channels",
    "@ursamu/ursamu/jobs": "jsr:@ursamu/jobs",
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/flags": "jsr:@std/flags@^0.224.0",
    "@std/fmt": "jsr:@std/fmt@^0.224.0",
    "@std/fmt/": "jsr:@std/fmt@^0.224.0/",
    "@std/fs": "jsr:@std/fs@^0.224.0",
    "@std/path": "jsr:@std/path@^0.224.0",
    "@std/semver": "jsr:@std/semver@^1.0.0",
    "@std/testing": "jsr:@std/testing@^1.0.17",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd",
    "@std/testing/mock": "jsr:@std/testing@^1.0.17/mock",
    "@ursamu/mushcode": "jsr:@ursamu/mushcode@^0.7.0",
    "@ursamu/mushcode/eval": "jsr:@ursamu/mushcode@^0.7.0/eval",
    "@ursamu/mushcode/parse": "jsr:@ursamu/mushcode@^0.7.0/parse",
    "@ursamu/parser": "npm:@ursamu/parser@1.2.4",
    "@digibear/tags": "npm:@digibear/tags@1.0.0",
    "bcrypt": "npm:bcryptjs@2.4.3",
    "djwt": "jsr:@zaubrik/djwt@^3.0.2",
    "dotenv": "jsr:@std/dotenv@^0.224.0",
    "dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "dotenv/load": "jsr:@std/dotenv@^0.224.0/load",
    "@std/dotenv": "jsr:@std/dotenv@^0.224.0",
    "@std/dotenv/": "jsr:@std/dotenv@^0.224.0/",
    "lodash": "npm:lodash@^4.18.1",
    "quickjs-emscripten": "npm:quickjs-emscripten@0.29.0",
    "@ursamu/builder": "jsr:@ursamu/builder",
    "@ursamu/channels": "jsr:@ursamu/channels",
    "@ursamu/help": "jsr:@ursamu/help",
    "@ursamu/help-plugin": "jsr:@ursamu/help",
    "@ursamu/bbs": "jsr:@ursamu/bbs",
    "@ursamu/mail": "jsr:@ursamu/mail",
    "@ursamu/mail-plugin": "jsr:@ursamu/mail",
    "@ursamu/wiki": "jsr:@ursamu/wiki",
    "@ursamu/jobs": "jsr:@ursamu/jobs",
    "@ursamu/jobs-plugin": "jsr:@ursamu/jobs",
    "@ursamu/combat": "jsr:@ursamu/combat",
    "@ursamu/cofd": "jsr:@ursamu/cofd",
    "@ursamu/cofd-plugin": "jsr:@ursamu/cofd",
    "@ursamu/lang": "jsr:@ursamu/lang",
    "@ursamu/lang-plugin": "jsr:@ursamu/lang"
  }
}