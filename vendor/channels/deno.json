{
  "name": "@ursamu/channels",
  "version": "0.1.2",
  "exports": {
    ".": "./mod.ts",
    "./channel-events": "./src/channel-events.ts"
  },
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@ursamu/mush": "./../mush/mod.ts",
    "@ursamu/core": "jsr:@ursamu/core@^0.1.5",
    "@ursamu/help-plugin": "./../help/mod.ts",
    "@ursamu/help": "./../help/mod.ts"
  },
  "publish": {
    "include": [
      "src",
      "help",
      "mod.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
