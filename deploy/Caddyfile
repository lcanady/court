# Court of Miracles — public edge (install: sudo cp to /etc/caddy/Caddyfile)
# HTTPS → game HTTP API :4203
# /ws   → game WebSocket :4202 (TLS terminated by Caddy)
#
# Mobile notes:
# - Disable HTTP/3 (QUIC). Some cellular stacks mishandle WS when
#   Alt-Svc advertises h3; force h1/h2 only.
# - Do not gzip /ws; flush immediately; forward client IP.
{
	servers {
		protocols h1 h2
	}
}

court.ursamu.io {
	handle /ws* {
		reverse_proxy 127.0.0.1:4202 {
			header_up Host {host}
			header_up X-Real-IP {remote_host}
			header_up X-Forwarded-For {remote_host}
			header_up X-Forwarded-Proto {scheme}
			flush_interval -1
		}
	}

	handle {
		encode gzip
		reverse_proxy 127.0.0.1:4203
	}
}
