{
  "name": "@ursamu/discord",
  "version": "0.2.2",
  "exports": "./mod.ts",
  "tasks": {
    "test": "deno test tests/ --allow-all --unstable-kv --no-check",
    "lint": "deno lint",
    "check": "deno check mod.ts --unstable-kv",
    "publish:dry": "deno publish --dry-run --allow-slow-types"
  },
  "compilerOptions": {
    "lib": [
      "deno.window",
      "deno.unstable"
    ]
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^0.224.0",
    "@std/testing/bdd": "jsr:@std/testing@^1.0.17/bdd",
    "@ursamu/mush": "./../mush/mod.ts",
    "@ursamu/core": "jsr:@ursamu/core@^0.1.5",
    "@ursamu/help": "./../help/mod.ts",
    "@ursamu/help-plugin": "./../help/mod.ts",
    "@ursamu/channels": "./../channels/mod.ts",
    "@ursamu/jobs": "jsr:@ursamu/jobs@^0.1.0",
    "tweetnacl": "npm:tweetnacl@1.0.3"
  },
  "publish": {
    "include": [
      "src",
      "help",
      "mod.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    }
  }
}
