{
  "server": {
    "standaloneTelnet": true,
    "telnet": 4201,
    "wsPort": 4202,
    "ws": 4202,
    "port": 4203,
    "http": 4203,
    "apiPort": 4203,
    "db": "data/typegraph.db",
    "plugins": [
      "@ursamu/builder",
      "@ursamu/channels",
      "@ursamu/help",
      "@ursamu/bbs",
      "@ursamu/mail",
      "@ursamu/jobs",
      "@ursamu/combat",
      "@ursamu/cofd-plugin",
      "@ursamu/lang-plugin",
      "@ursamu/discord",
      "@ursamu/wiki",
      "@ursamu/web",
      "@ursamu/site"
    ]
  },
  "game": {
    "name": "Court of Miracles",
    "description": "A custom UrsaMU game",
    "version": "0.0.1",
    "playerStart": "1",
    "text": {
      "connect": "text/default_connect.txt"
    },
    "layout": {
      "header": "[center(%ch%cy%b%0%b%cn,%1,%cg=%cn)]",
      "divider": "[if(neq(words(%0),0), center(%ch%cy%b%0%b%cn,%1,%cg-%cn), repeat(%cg-%cn,%1))]",
      "footer": "[repeat(%cg=%cn,%1)]"
    }
  },
  "plugins": {
    "site": {
      "skin": "court",
      "title": "Court of Miracles",
      "bannerImage": "/site/theme/installed/court/imgs/header.png",
      "serveRoot": true,
      "telnet": "court.ursamu.io:4201",
      "nav": [
        {
          "id": "home",
          "label": "Home",
          "href": "/",
          "order": 10
        },
        {
          "id": "wiki",
          "label": "Wiki",
          "href": "/wiki/",
          "order": 20
        },
        {
          "id": "help",
          "label": "Help",
          "href": "#",
          "order": 30
        }
      ],
      "skinCss": "/site/theme/installed/court/site.css",
      "themeDir": "theme",
      "plainBg": true
    },
    "channels": {
      "defaults": [
        {
          "name": "Public",
          "alias": "pub",
          "lock": "connected",
          "announce": true
        },
        {
          "name": "Admin",
          "alias": "ad",
          "lock": "connected admin+",
          "announce": false
        }
      ]
    },
    "globals": {
      "theme": {
        "look": {
          "showShortDesc": true,
          "showIdle": true,
          "categorizeExits": true,
          "showExitAliases": true,
          "aliasCase": "preserve",
          "exitColumns": 2,
          "descIndent": 2,
          "roleTags": [
            {
              "flag": "wizard",
              "display": "(Wizard)"
            },
            {
              "flag": "superuser",
              "display": "%ch%cy<Dev>%cn"
            },
            {
              "flag": "admin",
              "display": "(Admin)"
            },
            {
              "flag": "staff",
              "display": "(Staff)"
            },
            {
              "flag": "builder",
              "display": "(Builder)"
            }
          ]
        }
      }
    },
    "cofd": {
      "oocRoom": "1",
      "icHub": "14",
      "oocRooms": [
        "1",
        "5",
        "8",
        "11"
      ]
    }
  }
}
